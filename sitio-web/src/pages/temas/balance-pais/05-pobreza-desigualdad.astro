<Chapter
  number="05"
  title="Pobreza y desigualdad"
  subtitle="Pobreza monetaria, GINI, IPM. La reducción real y la que se atribuye. Cómo llega el país en su reto social más profundo."
  chapterNumber={5}
  totalChapters={8}
  prevHref="/temas/balance-pais/04-finanzas-estado"
  prevTitle="Finanzas del Estado"
  nextHref="/temas/balance-pais/06-seguridad"
